  {
   "type": "dsa2",
   "kind": "code",
   "vo": "Now the code. In push, start with the new number. If a box is below, compare with its note. Store both. Pop removes both. Get min reads the top note.",
   "data": {
    "lines": [
     "The *code*"
    ],
    "code": [
     "def push(self, x):",
     "  low = x",
     "  if self.st:",
     "    low = min(x, self.st[-1][1])",
     "  self.st.append((x, low))",
     "def pop(self):",
     "  self.st.pop()",
     "def getMin(self):",
     "  return self.st[-1][1]"
