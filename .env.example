# ---------- voice ----------
TTS_ENGINE=edge                 # edge (free) | sarvam | silent
EDGE_VOICE=hi-IN-MadhurNeural    # or hi-IN-SwaraNeural (female)
EDGE_RATE=+8%
SARVAM_API_KEY=
SARVAM_SPEAKER=shubh
SARVAM_MODEL=bulbul:v3

# ---------- public media storage (Cloudflare R2 free tier or any S3) ----------
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=debug-bro-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
PUBLIC_MEDIA_BASE=https://pub-xxxxxxxx.r2.dev   # public URL of the bucket

# ---------- Instagram (Instagram API with Instagram Login) ----------
IG_USER_ID=
IG_ACCESS_TOKEN=                # long-lived, 60 days; refresh with: npm run refresh-token
IG_GRAPH_HOST=graph.instagram.com
IG_API_VERSION=v26.0

# ---------- approval on your phone (optional, free) ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
APPROVAL=on                     # on | off
APPROVAL_TIMEOUT_MIN=120
APPROVAL_DEFAULT=approve        # what happens if you don't tap anything: approve | skip

# ---------- local rendering ----------
# REMOTION_BROWSER=/path/to/chrome-headless-shell   # only if Remotion can't download its own browser
